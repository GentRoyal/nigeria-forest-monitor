# Local-only service ports
NFM_WEB_PORT=3000
NFM_API_PORT=8000
NFM_TILES_PORT=8001
NFM_AIRFLOW_PORT=8080
NFM_POSTGRES_PORT=5433

# Used only by the local PostgreSQL container. Application and Airflow accounts
# are created by infra/postgres/init/001-create-databases.sql.
NFM_POSTGRES_SUPERUSER_PASSWORD=postgres-local-only

# Local seeded owner. Change these before sharing a development environment.
NFM_SEED_ADMIN_EMAIL=owner@nfm.local
NFM_SEED_ADMIN_PASSWORD=LocalForest!2026
NFM_ACCESS_TOKEN_SECRET=local-development-signing-key-change-me
NFM_PASSWORD_PEPPER=local-development-pepper-change-me
NFM_COOKIE_SECURE=false
NFM_COOKIE_SAMESITE=strict

# Shared analytical configuration
FOREST_MONITOR_ROOT=C:\path\to\nigeria-forest-monitor
GEE_PROJECT=your-google-cloud-project-id
ACLED_EMAIL=legacy-research-only
ACLED_PASSWORD=legacy-research-only
